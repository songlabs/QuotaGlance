    "Open QuotaGlance on iPhone to connect and refresh.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open QuotaGlance on iPhone to connect and refresh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone 上打开 QuotaGlance 以连接并刷新。"

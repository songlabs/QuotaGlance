    "Provider rate-limited refresh. Try again later.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Provider rate-limited refresh. Try again later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务商限制了刷新频率。请稍后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "服務商限制了重新整理頻率。請稍後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロバイダーにより更新が制限されています。後でもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제공자가 새로 고침을 제한했습니다. 나중에 다시 시도하세요."
          }
        }
      }
    },
    "Provider response changed. Cached data is preserved.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Provider response changed. Cached data is preserved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务商响应已更改。已保留缓存数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "服務商回應已變更。已保留快取資料。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロバイダーの応答が変更されました。キャッシュデータは保持されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제공자 응답이 변경되었습니다. 캐시된 데이터는 유지됩니다."
          }
        }
      }
    },

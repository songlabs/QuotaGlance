        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone 上開啟 QuotaGlance 以連線並重新整理。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone で QuotaGlance を開いて接続し、更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone에서 QuotaGlance를 열어 연결하고 새로 고치세요."
